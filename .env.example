# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก .gitignore ไว้แล้ว)
# บน Vercel ให้ใส่ค่าเดียวกันที่ Project Settings → Environment Variables

# --- เฟส 1 ---

# API key จาก https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ชื่อรุ่นโมเดล ตรวจชื่อที่ถูกต้องได้ที่หน้า Models ของ OpenAI
OPENAI_MODEL=gpt-5.6-luna

# รหัสผ่านเข้าเว็บ
APP_PASSWORD=

# ใช้เซ็น cookie ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างด้วยคำสั่ง:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- เฟส 2 ---
# DATABASE_URL=

# --- เฟส 3 ---
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_OWNER_USER_ID=
# CRON_SECRET=
